# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Database - Local MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/opendev-orchestrator

# Optional. Comma-separated loopback browser origins.
# The default is http://127.0.0.1:5173 when this is unset.
# CORS_ORIGINS=http://127.0.0.1:5173

# Optional local Ollama API. Loopback only.
# The default is http://127.0.0.1:11434 when this is unset.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MAX_CONCURRENT_PULLS=1
# OLLAMA_REQUEST_TIMEOUT_MS=4000
# OLLAMA_PULL_TIMEOUT_MS=1800000
